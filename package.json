{
  "name": "vue-hand-note",
  "version": "0.1.0",
  "description": "A lightweight handwritten annotation component for Vue 3 with automatic arrows and eight directions.",
  "type": "module",
  "main": "./dist/vue-hand-note.umd.cjs",
  "module": "./dist/vue-hand-note.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-hand-note.js",
      "require": "./dist/vue-hand-note.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "pack:check": "npm pack --dry-run --cache .npm-cache"
  },
  "keywords": [
    "vue",
    "vue3",
    "typescript",
    "annotation",
    "handwriting",
    "hand-drawn",
    "tooltip",
    "ui-component"
  ],
  "author": "totorookay-maker",
  "license": "MIT",
  "homepage": "https://github.com/totorookay-maker/vue-hand-note#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totorookay-maker/vue-hand-note.git"
  },
  "bugs": {
    "url": "https://github.com/totorookay-maker/vue-hand-note/issues"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.18",
    "vue-tsc": "^3.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
